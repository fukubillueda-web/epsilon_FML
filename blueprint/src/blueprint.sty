\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{blueprint}[2026/08/20 Local Lean blueprint helpers]
\RequirePackage{xcolor}
\RequirePackage[hypertexnames=false]{hyperref}
\RequirePackage{enumitem}
\RequirePackage{microtype}
